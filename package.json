{
  "name": "opsis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm engine:build && pnpm --parallel --filter web --filter api dev",
    "engine:build": "pnpm --filter @opsis/engine build",
    "engine:test": "pnpm --filter @opsis/engine test:rust",
    "engine:check": "pnpm --filter @opsis/engine check:rust",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm engine:build && pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm engine:build && vitest run",
    "test:browser": "playwright test",
    "test:qa": "pnpm build && pnpm test && pnpm test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7",
    "wasm-pack": "0.15.0",
    "zod": "^3.25.76"
  }
}
